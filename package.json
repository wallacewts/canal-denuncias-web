{
  "name": "canal-denuncias-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:portal": "ng serve portal",
    "start:backoffice": "ng serve backoffice",
    "build": "ng build portal && ng build backoffice",
    "build:portal": "ng build portal",
    "build:backoffice": "ng build backoffice",
    "test": "ng test shared --watch=false && ng test portal --watch=false && ng test backoffice --watch=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "e2e": "sh scripts/e2e.sh",
    "lint:rules": "node scripts/check-lint-rules.mjs",
    "check:build": "node scripts/check-build-output.mjs",
    "api:sync": "node scripts/api-sync.mjs",
    "api:generate": "ng-openapi-gen -c ng-openapi-gen.public.json && ng-openapi-gen -c ng-openapi-gen.admin.json",
    "api:check": "node scripts/api-check.mjs",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource/roboto": "^5.3.0",
    "material-symbols": "^0.49.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "4.14.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.2",
    "ng-openapi-gen": "1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{scss,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
