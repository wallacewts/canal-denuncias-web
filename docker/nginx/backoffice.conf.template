# Backoffice (equipe interna).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    charset utf-8;
    # Equipe interna: log de acesso padrão (IP da equipe também vai para a auditoria da API).
    access_log /dev/stdout;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Health check do container (sem log).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # index.html: nonce novo a cada requisição e nunca em cache.
    location = /index.html {
        sub_filter_once off;
        sub_filter_types text/html;
        sub_filter '__CSP_NONCE__' $request_id;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Proxy da API (FTRV-04). A API audita as ações da equipe com o IP real (D25, AUDIT-03); o cookie de sessão vai junto.
    # $proxy_add_x_forwarded_for acrescenta o IP real ao fim, então um X-Forwarded-For forjado não o substitui.
    location /api/ {
        proxy_pass ${APP_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Configuração em tempo de execução, montada no container.
    location = /config.json {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Arquivos com hash no nome: cache longo.
    location ~ ^/(?:chunk-|main-|polyfills-|styles-|media/) {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Fallback de SPA: qualquer outra rota cai no index.html.
    location / {
        try_files $uri /index.html;
        include /etc/nginx/conf.d/security-headers.inc;
    }
}
