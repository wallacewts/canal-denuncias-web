    "/api/admin/v1/auth/mfa/challenge": {
      "post": {
        "operationId": "AuthController_challenge",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "code": {
                        "maxLength": 16,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": ["code"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "recoveryCode": {
                        "maxLength": 64,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": ["recoveryCode"],
                    "type": "object"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "absoluteExpiresAt": {
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                      "type": "string"
                    },
                    "idleExpiresAt": {
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                      "type": "string"
                    },
                    "nextStep": {
                      "enum": [
                        "MFA_REQUIRED",
                        "MFA_ENROLLMENT_REQUIRED",
                        "PASSWORD_CHANGE_REQUIRED",
                        "DONE"
                      ],
                      "type": "string"
                    }
                  },
                  "required": ["nextStep", "idleExpiresAt", "absoluteExpiresAt"],
                  "type": "object"
                }
              }
            },
            "description": "Próxima etapa e horários; cookie novo."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "corpo inválido"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "sessão pendente ausente ou expirada"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "escrita de outra origem (proteção por origem)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "códigos: MFA_CODE_INVALID"
          },
          "423": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "códigos: MFA_LOCKED"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "códigos: TOO_MANY_ATTEMPTS"
          }
        },
        "tags": ["admin"]
      }
    },
    "/api/admin/v1/auth/mfa/enrollment": {
      "post": {
        "operationId": "AuthController_enroll",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "otpauthUri": {
                      "format": "starts_with",
                      "maxLength": 2048,
                      "pattern": "^otpauth:\\/\\/totp\\/.*",
                      "type": "string"
                    },
                    "qrCodeDataUri": {
                      "pattern": "^data:image\\/png;base64,[A-Za-z0-9+/]+=*$",
                      "type": "string"
                    },
                    "secret": {
                      "maxLength": 128,
                      "pattern": "^[A-Z2-7]+=*$",
                      "type": "string"
                    }
                  },
                  "required": ["otpauthUri", "qrCodeDataUri", "secret"],
                  "type": "object"
                }
              }
            },
            "description": "URI, QR code PNG e segredo (só nesta resposta)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "sessão ausente ou expirada"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "códigos: STEP_NOT_ALLOWED"
          }
        },
        "tags": ["admin"]
      }
    },
    "/api/admin/v1/auth/mfa/enrollment/confirmation": {
      "post": {
        "operationId": "AuthController_confirmEnrollment",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "maxLength": 16,
                    "minLength": 1,
