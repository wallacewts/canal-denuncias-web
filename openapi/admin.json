                      "type": "string"
                    },
                    "recoveryCodes": {
                      "items": {
                        "maxLength": 64,
                        "type": "string"
                      },
                      "maxItems": 10,
                      "minItems": 10,
                      "type": "array"
                    }
                  },
                  "required": ["recoveryCodes", "nextStep", "idleExpiresAt", "absoluteExpiresAt"],
                  "type": "object"
                }
              }
            },
            "description": "10 códigos de recuperação (uma única vez), próxima etapa e horários; cookie novo."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "corpo inválido"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "sessão ausente ou expirada"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "códigos: STEP_NOT_ALLOWED"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "códigos: MFA_CODE_INVALID"
          }
        },
        "tags": ["admin"]
      }
    },
