                  "additionalProperties": false,
                  "properties": {
                    "abilities": {
                      "items": {
                        "enum": [
                          "users.manage",
                          "categories.manage",
                          "settings.sla",
                          "retention.manage",
                          "reports.list",
                          "reports.read",
                          "reports.triage",
